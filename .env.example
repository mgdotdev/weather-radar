# Copy to `.env` next to docker-compose.yml and fill in. Compose substitutes
# these into the service's `environment:` block. On TrueNAS "Install via YAML",
# set the same values directly in the YAML's environment section instead (the
# UI may not load a .env file).

# --- REQUIRED for a remote (non-localhost) deployment -----------------------
# Without an admin password the /admin page is localhost-only, so you can't
# mint the first access token from another machine -> the app is unreachable.
# Generate the hash with:  ./run.sh hash_password
WR_ADMIN_PASSWORD_HASH=

# Stable signing key for admin sessions (any long random string). If unset,
# admin login sessions drop on every restart. Generate e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
WR_ADMIN_SECRET=

# --- Optional ---------------------------------------------------------------
# NOAA contact. api.weather.gov REQUIRES a User-Agent and asks that it include
# a contact email so they can reach you about your usage. Set your email here;
# the UA is sent as "weather-radar (your@email)". This SAME email also
# identifies the app to Nominatim (the address-search geocoder). Strongly
# recommended.
WR_CONTACT_EMAIL=
# App name used in the User-Agent (default "weather-radar").
# WR_APP_NAME=weather-radar
# Full User-Agent override (takes precedence over WR_APP_NAME/WR_CONTACT_EMAIL).
# NOAA_USER_AGENT=
# Full geocode (Nominatim) User-Agent override.
# GEOCODE_USER_AGENT=

# Plaintext admin password (used only if WR_ADMIN_PASSWORD_HASH is unset).
# WR_ADMIN_PASSWORD=

# Weather data source: nbm (default) | ndfd | gridpoints
WR_WEATHER_SOURCE=nbm

# Geocode (Nominatim) upstream rate limit. Nominatim's policy caps us at 1
# request/second; the server gate enforces this on cache MISSES (hits bypass
# it). Interactive searches wait up to GEOCODE_MAX_WAIT for a slot, else 503.
# GEOCODE_MIN_INTERVAL=1.0
# GEOCODE_MAX_WAIT=3.0

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=WARNING

# Uvicorn worker processes.
WR_WORKERS=4
